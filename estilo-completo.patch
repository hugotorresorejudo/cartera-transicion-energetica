+.metodo h3{font-size:1.125rem;border-bottom:1px solid var(--linea);padding-bottom:.5rem;margin-top:2rem}
+/* inicio: listas con líneas, sin tarjetas */
+.intro{border:0;border-left:4px solid var(--cobalto);background:none;padding:.25rem 0 .25rem 1rem;margin:.5rem 0 2rem;font-size:1.0625rem;color:var(--suave);max-width:48rem}
+.categoria{color:var(--marino);background:none;font-size:1.125rem;font-weight:700;margin:2.5rem 0 .5rem;padding:0 0 .5rem;border-bottom:2px solid var(--marino);border-radius:0}
+.tarjetas-inicio{display:grid;grid-template-columns:repeat(auto-fill,minmax(264px,1fr));column-gap:2rem}
+.tarjeta{background:none;border:0;border-bottom:1px solid var(--linea);border-radius:0;box-shadow:none;padding:1rem 0;display:flex;flex-direction:column;gap:.25rem;transition:none}
+.tarjeta:hover{background:none}
+.tarjeta h4{font-size:1.0625rem;margin:0;color:var(--marino)}
+.tarjeta p{font-size:.9375rem;color:var(--suave);margin:0 0 .5rem;flex:1}
+.tarjeta .meta{font-size:.75rem;color:var(--suave);font-weight:500;letter-spacing:.04em;text-transform:uppercase}
+.tarjeta .btn{align-self:flex-start;padding:.25rem 1.5rem}
+.pie{border-top:2px solid var(--marino);background:#fff;margin-top:3rem;padding:1.5rem;font-size:.875rem;color:var(--suave)}
+.pie p{margin:.25rem 0}
+@media (max-width:576px){.contenido{padding:1rem}h2{font-size:1.5rem}.kpi,.kpi:first-child{border-left:0;padding:1rem 0;border-top:1px solid var(--linea)}.kpi:first-child{border-top:0}.kpi-grande .kpi-valor{font-size:2.25rem}.nav-tabs{overflow-x:auto}.nav-tabs .nav-link{padding:.5rem 1rem;white-space:nowrap}h1.bslib-page-title{font-size:1rem}.navbar.navbar-static-top .container-fluid{padding:0 1rem}}
+@media (max-width:576px){.nav-tabs{flex-wrap:nowrap;gap:.25rem}.nav-tabs .nav-link{padding:.5rem .75rem;font-size:.875rem}h1.bslib-page-title{font-size:.9375rem;letter-spacing:0}}
