++/* ===== Estilo v2: blanco y gama de azules ===== */
++:root{--azul-50:#f4f8ff;--azul-100:#e8f0ff;--azul-200:#cfe0ff;--azul-500:#3b82f6;--azul-600:#1f63d8;--azul-700:#174fb0;--azul-900:#0b2a5b;
++  --sombra:0 1px 2px rgba(11,42,91,.05),0 6px 20px rgba(31,99,216,.07)}
++html,body{background:#fff;color:var(--azul-900);-webkit-font-smoothing:antialiased;font-feature-settings:"tnum"}
++body{background:radial-gradient(1200px 400px at 85% -120px,#e8f0ff 0,rgba(232,240,255,0) 70%),#fff}
++header.navbar,.bslib-page-sidebar>header{background:rgba(255,255,255,.88)!important;backdrop-filter:blur(8px);border-bottom:1px solid var(--borde)!important;color:var(--azul-900)}
++.bslib-page-title{font-size:1.15rem;font-weight:700;letter-spacing:-.01em;color:var(--azul-900);display:flex;align-items:center;gap:.55rem}
++.bslib-page-title:before{content:"";width:12px;height:12px;border-radius:4px;background:linear-gradient(135deg,var(--azul-500),var(--azul-700));box-shadow:0 0 0 4px var(--azul-100)}
++.bslib-sidebar-layout>.sidebar{background:var(--azul-50);border-right:1px solid var(--borde)}
++.nav-grupo{font-size:.68rem;letter-spacing:.09em;color:#7a8bb0;border-top:0;margin:1.1rem 0 .3rem;padding-left:.2rem}
++.nav-item a{border-left:0;border-radius:9px;padding:.4rem .65rem;color:var(--azul-900);font-size:.88rem;transition:background .12s,color .12s}
++.nav-item a:hover{background:var(--azul-100)}
++.nav-item a.activo{background:var(--azul-600);color:#fff;font-weight:600;box-shadow:0 4px 12px rgba(31,99,216,.28)}
++.nav-item .id{color:#7a8bb0;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.72rem}
++.nav-item a.activo .id{color:#cfe0ff}
++h2{font-weight:750;letter-spacing:-.025em;color:var(--azul-900)}
++.text-muted{color:var(--suave)!important}
++.contenido{max-width:1120px}
++/* tarjetas y bloques */
++.kpi,.tarjeta,.adv-fila,.shiny-plot-output,.tabla-wrap{background:#fff;border:1px solid var(--borde);border-radius:14px;box-shadow:var(--sombra)}
++.kpi{border-left:1px solid var(--borde);position:relative;overflow:hidden;padding:1rem 1.1rem}
++.kpi:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(180deg,var(--azul-500),var(--azul-700))}
++.kpi-ahorro:before{background:linear-gradient(180deg,#34d399,var(--ahorro))}
++.kpi-coste:before{background:linear-gradient(180deg,#fb9a6a,var(--coste))}
++.kpi-ahorro,.kpi-coste{border-left:1px solid var(--borde)}
++.kpi-valor{color:var(--azul-700)}
++.kpi-ahorro .kpi-valor{color:var(--ahorro)}.kpi-coste .kpi-valor{color:var(--coste)}
++.kpi-grande .kpi-valor{font-size:2.3rem;font-weight:700;letter-spacing:-.03em}
++.kpi-nombre{color:var(--suave);font-size:.8rem;font-weight:500}
++.kpi-rango,.kpi-prob{color:var(--suave)}
++.chip{border-color:var(--azul-200);color:var(--azul-700);background:var(--azul-50)}
++.chip-pend{border-color:#f3d6b8;color:#9a4f12;background:#fff7ee}
++.chip-editado{border-color:var(--azul-500);color:#fff;background:var(--azul-600)}
++.tarjetas-inicio{grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.9rem}
++.tarjeta{padding:1rem 1.1rem;transition:transform .15s,box-shadow .15s,border-color .15s}
++.tarjeta:hover{transform:translateY(-3px);border-color:var(--azul-200);box-shadow:0 2px 4px rgba(11,42,91,.05),0 14px 30px rgba(31,99,216,.14)}
++.tarjeta h4{color:var(--azul-900);font-size:1rem;font-weight:700}
++.tarjeta .meta{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:#7a8bb0;font-size:.72rem}
++.prio{font-size:.66rem;font-weight:700;padding:.05rem .5rem;border-radius:999px;background:var(--azul-100);color:var(--azul-700)}
++.prio-2{background:#eef2fa;color:#5a6b8c}.prio-3{background:#f1f5fb;color:#7a8bb0}
++.btn-outline-primary{border-color:var(--azul-200);color:var(--azul-700);border-radius:9px;font-weight:600;background:#fff}
++.btn-outline-primary:hover{background:var(--azul-600);border-color:var(--azul-600);color:#fff}
++.btn-primary{background:linear-gradient(180deg,#3b82f6,var(--azul-600));border:0;border-radius:10px;font-weight:650;padding:.55rem 1.5rem;box-shadow:0 6px 16px rgba(31,99,216,.3)}
++.btn-primary:hover{background:linear-gradient(180deg,#2f76ea,var(--azul-700))}
++/* pestañas tipo segmentado */
++.nav-tabs{border:0;background:var(--azul-50);padding:.25rem;border-radius:12px;display:inline-flex;gap:.15rem;margin-bottom:.8rem}
++.nav-tabs .nav-link{border:0;border-radius:9px;color:var(--suave);font-weight:550;padding:.4rem 1rem}
++.nav-tabs .nav-link:hover{color:var(--azul-700)}
++.nav-tabs .nav-link.active{background:#fff;color:var(--azul-700);font-weight:700;box-shadow:0 1px 3px rgba(11,42,91,.12)}
++.barra-acciones{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);padding:.55rem 0;margin:.2rem 0}
++/* formularios */
++.shiny-input-container label.control-label{font-weight:650;font-size:.88rem;color:var(--azul-900)}
++.form-control,.form-select{border-radius:9px;border-color:var(--borde)}
++.form-control:focus,.form-select:focus{border-color:var(--azul-500);box-shadow:0 0 0 .2rem rgba(59,130,246,.18)}
++.form-check-input:checked{background-color:var(--azul-600);border-color:var(--azul-600)}
++.adv-fila{padding:.6rem .75rem}
++.adv-rango{color:#7a8bb0}
++/* tablas */
++.tabla th,.tabla-md th{background:var(--azul-50);color:var(--azul-700);font-weight:650;font-size:.78rem;text-transform:uppercase;letter-spacing:.04em}
++.tabla td,.tabla th,.tabla-md td,.tabla-md th{border-bottom:1px solid #edf2fb}
++/* hero */
++.hero{background:linear-gradient(120deg,#f2f7ff 0,#e1ecff 55%,#cfe0ff 100%);border:1px solid var(--azul-200);color:var(--azul-900);border-radius:20px;padding:2rem 2rem 1.6rem;margin:.4rem 0 1.2rem;box-shadow:var(--sombra);position:relative;overflow:hidden}
++.hero:after{content:"";position:absolute;right:-60px;top:-60px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(59,130,246,.28),rgba(59,130,246,0) 70%)}
++.hero h2{font-size:2rem;max-width:40rem;margin:0 0 .6rem;color:var(--azul-900)}
++.hero p{color:#3d5486;max-width:44rem;margin:0 0 1.1rem}
++.hero .cifras{display:flex;flex-wrap:wrap;gap:.6rem;position:relative;z-index:1}
++.hero .cifra{background:rgba(255,255,255,.75);border:1px solid var(--azul-200);border-radius:12px;padding:.5rem .9rem;font-size:.8rem;color:var(--suave)}
++.hero .cifra b{display:block;font-size:1.25rem;color:var(--azul-700);font-weight:750}
++.hero .btn{background:linear-gradient(180deg,#3b82f6,var(--azul-600));color:#fff;border:0;font-weight:650;margin-top:1.1rem;border-radius:10px;padding:.55rem 1.3rem;box-shadow:0 6px 16px rgba(31,99,216,.3);position:relative;z-index:1}
++.categoria{font-size:.8rem;font-weight:750;margin:1.6rem 0 .6rem;color:var(--azul-700);text-transform:uppercase;letter-spacing:.09em;display:flex;align-items:center;gap:.7rem}
++.categoria:after{content:"";flex:1;height:1px;background:linear-gradient(90deg,var(--azul-200),rgba(207,224,255,0))}
