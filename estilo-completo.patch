++        hero = ui.div(
++            ui.h2("Decisiones energéticas para tu hogar, con la incertidumbre a la vista"),
++            ui.p("22 herramientas que comparten tu perfil «Mi hogar». Responde unas pocas preguntas y obtén rangos (P10–P50–P90) en lugar de cifras únicas, "
++                 "con el método, las fuentes y la fecha de los datos a un clic."),
++            ui.div(ui.div(ui.tags.b("22"), "herramientas", class_="cifra"), ui.div(ui.tags.b("P10–P90"), "Monte Carlo", class_="cifra"),
++                   ui.div(ui.tags.b("100 %"), "en tu navegador", class_="cifra"), ui.div(ui.tags.b("0"), "datos enviados", class_="cifra"), class_="cifras"),
++            ui.input_action_button("go_t01", "Empezar por las tarifas", class_="btn"), class_="hero")
++        return ui.div(hero, *bloques)
