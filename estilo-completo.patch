+@@ -1,4 +1,4 @@
+-:root{--acento:#0f5c7a;--texto:#1d2630;--suave:#5b6773;--borde:#d5dbe1;--fondo:#f6f8fa;--ahorro:#1f8a5b;--coste:#c2571a;--tarjeta:#fff}
++:root{--acento:#1f63d8;--texto:#0b2a5b;--suave:#5a6b8c;--borde:#dbe5f5;--fondo:#ffffff;--ahorro:#12945f;--coste:#d9622b;--tarjeta:#fff}
