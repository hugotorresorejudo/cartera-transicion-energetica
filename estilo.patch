+.form-control,.form-select{border-radius:2px;border-color:#9fb0c2;font-size:.9rem}
+.form-control:focus,.form-select:focus{border-color:var(--azul);box-shadow:0 0 0 2px rgba(0,80,140,.2)}
+.form-check-input:checked{background-color:var(--azul);border-color:var(--azul)}
+/* avanzado */
+.adv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.6rem .8rem}
+.adv-fila{background:#fff;border:1px solid var(--borde);border-radius:2px;padding:.5rem .65rem}
+.adv-etq{font-size:.9rem;font-weight:700;color:var(--azul-osc)}.adv-unidad{font-size:.85rem;color:var(--suave)}
+.adv-ctrl{display:flex;align-items:center}.adv-ctrl .form-group{margin:0;flex:1}
+.adv-rango{font-size:.85rem;color:var(--suave);min-height:1.2em}
+/* tablas y gráficos */
+.tabla-wrap,.tabla-md{overflow-x:auto;margin:.6rem 0;background:#fff}
+.tabla,.tabla-md table{border-collapse:collapse;width:100%;font-size:.9rem}
+.tabla th,.tabla-md th{background:var(--azul);color:#fff;font-weight:700;text-align:left;padding:.4rem .6rem;border:1px solid var(--azul)}
+.tabla td,.tabla-md td{padding:.4rem .6rem;border:1px solid var(--borde);vertical-align:top}
+.tabla tbody tr:nth-child(even) td,.tabla-md tbody tr:nth-child(even) td{background:var(--gris)}
+.shiny-plot-output{background:#fff;border:1px solid var(--borde);border-radius:2px;margin:.6rem 0;padding:.2rem}
+.notas{padding-left:1.2rem}.notas li{font-size:.9rem;color:var(--texto);margin:.15rem 0}
+.eq{overflow-x:auto;padding:.3rem 0}
+.metodo h3{font-size:1.05rem;border-bottom:1px solid var(--borde);padding-bottom:.2rem;margin-top:1.3rem}
+/* inicio */
+.intro{border-left:4px solid var(--azul);background:var(--gris);padding:.7rem 1rem;margin:.4rem 0 1rem;font-size:.95rem}
+.categoria{background:var(--azul-osc);color:#fff;font-size:.95rem;font-weight:700;margin:1.2rem 0 .6rem;padding:.4rem .8rem;border-radius:2px}
+.tarjetas-inicio{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:.6rem}
+.tarjeta{background:#fff;border:1px solid var(--borde);border-radius:2px;padding:.7rem .8rem;display:flex;flex-direction:column;gap:.3rem;box-shadow:none;transition:none}
+.tarjeta:hover{border-color:var(--azul);background:var(--azul-cl)}
+.tarjeta h4{font-size:1rem;margin:0;color:var(--azul-osc)}
+.tarjeta p{font-size:.9rem;color:var(--texto);margin:0;flex:1}
+.tarjeta .meta{font-size:.8rem;color:var(--suave)}
+.pie{border-top:3px solid var(--azul);background:var(--gris);margin-top:2rem;padding:.8rem 1rem;font-size:.85rem;color:var(--suave)}
+.pie p{margin:.1rem 0}
+@media (max-width:576px){.contenido{padding:.2rem 0}.nav-tabs{overflow-x:auto}.nav-tabs .nav-link{padding:.4rem .7rem;white-space:nowrap}.bslib-page-title{font-size:.95rem}}
+header.bslib-page-title,.bslib-page-title{background:var(--azul-osc)!important;color:#fff!important;border-bottom:4px solid var(--azul)!important;padding:.6rem 1rem!important;margin:0;font-size:1.1rem;font-weight:700}
+header.bslib-page-title{margin:0!important;width:100%;white-space:normal!important;line-height:1.25;border-radius:0}
+@media (max-width:576px){header.bslib-page-title{font-size:.95rem;padding:.5rem .8rem!important}}
+.navbar.navbar-static-top{background:var(--azul-osc)!important;border-bottom:4px solid var(--azul);padding:.55rem 0}
+.navbar.navbar-static-top .container-fluid{padding:0 1rem}
+h1.bslib-page-title{background:none!important;border:0!important;padding:0!important;width:auto;color:#fff!important;margin:0!important}
